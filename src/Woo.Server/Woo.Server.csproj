<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <WebDist>$(MSBuildThisFileDirectory)..\..\web\dist\</WebDist>
    <WooVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\VERSION').Trim())</WooVersion>
    <!-- Coordinated builds (scripts/build.mjs) pass WooCommit, WooBuiltAt and WooEnvironment.
         Standalone builds keep the honest local fallback: empty commit and build time. -->
    <WooEnvironment Condition="'$(WooEnvironment)' == ''">local</WooEnvironment>
    <!-- Keep the SDK from stamping its own "1.0.0+<git HEAD>"; build identity comes only from the values above. -->
    <InformationalVersion>$(WooVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="WooVersion" Value="$(WooVersion)" />
    <AssemblyMetadata Include="WooCommit" Value="$(WooCommit)" />
    <AssemblyMetadata Include="WooBuiltAt" Value="$(WooBuiltAt)" />
    <AssemblyMetadata Include="WooEnvironment" Value="$(WooEnvironment)" />
  </ItemGroup>

  <!-- Publish ships the Vite production build as wwwroot. Build web/ first (see README). -->
  <Target Name="IncludeWebDist" BeforeTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(WebDist)index.html')" Text="$(WebDist)index.html is missing. Run 'npm --prefix web ci' and 'npm --prefix web run build' before publishing, or use 'node scripts/build.mjs'." />
    <ItemGroup>
      <WebDistFile Include="$(WebDist)**\*" />
      <ResolvedFileToPublish Include="@(WebDistFile->'%(FullPath)')">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
